<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.souther-lang</groupId>
    <artifactId>souther-maven-plugin</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>maven-plugin</packaging>

    <name>Souther Maven Plugin</name>
    <description>
        Compiles Souther sources in a Maven build. The compiler is not linked: the Souther version
        the project names is resolved as souther-build-driver and run behind souther-build-api, so
        this plugin and the Souther it runs are released on their own terms.
    </description>
    <url>https://github.com/souther-lang/souther-maven-plugin</url>

    <licenses>
        <license>
            <name>Eclipse Public License - v 2.0</name>
            <url>https://www.eclipse.org/legal/epl-2.0/</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>kawasima</id>
            <name>kawasima</name>
            <url>https://github.com/kawasima</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/souther-lang/souther-maven-plugin.git</connection>
        <developerConnection>scm:git:git@github.com:souther-lang/souther-maven-plugin.git</developerConnection>
        <url>https://github.com/souther-lang/souther-maven-plugin</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- The same 17 souther-build-api is compiled to: this has to start on the JDK the build is
             already running so that a Souther needing a newer one is something it can report. -->
        <maven.compiler.release>17</maven.compiler.release>
        <maven.version>3.9.9</maven.version>
        <maven.resolver.version>1.9.22</maven.resolver.version>
        <junit.version>6.1.2</junit.version>
        <!-- The Souther this plugin release is verified against: what a project that names no
             version gets, and what the tests load. One property, so the two cannot differ — a
             default nothing was tested against is not one. -->
        <souther.default.version>0.1.0-rc5</souther.default.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-build-api</artifactId>
            <version>1.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${maven.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${maven.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>3.15.1</version>
            <scope>provided</scope>
        </dependency>
        <!-- Provided: the running Maven supplies the resolver, and a copy of it here would be a
             second one in the same realm. -->
        <dependency>
            <groupId>org.apache.maven.resolver</groupId>
            <artifactId>maven-resolver-api</artifactId>
            <version>${maven.resolver.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.resolver</groupId>
            <artifactId>maven-resolver-util</artifactId>
            <version>${maven.resolver.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test scope, so it is not on the class path this plugin is compiled against: the plugin
             must not be able to name anything of the compiler's, and leaving it off is what says so.
             On the test class path deliberately, though — that is where the same class is reachable
             two ways, which is the condition the loader has to be right about. -->
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-build-driver</artifactId>
            <version>${souther.default.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- So the Souther version this release was verified against is written into the artifact
             rather than named in the code twice. A test refuses an unfiltered placeholder. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>3.15.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
            </plugin>
            <!-- A real Maven build over a real project, which is the only place the goal's binding,
                 its parameters and Maven Resolver are exercised. The unit tests stand in for the
                 resolution; this does not. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-invoker-plugin</artifactId>
                <version>3.9.0</version>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.groovy</groupId>
                        <artifactId>groovy</artifactId>
                        <version>5.0.6</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <projectsDirectory>src/it</projectsDirectory>
                    <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
                    <!-- A repository of the build's own. Pointed at the developer's, a plain
                         `mvn verify` installs this snapshot of the plugin where every other build on
                         the machine resolves from — including a run that failed. -->
                    <localRepositoryPath>${project.build.directory}/local-repo</localRepositoryPath>
                    <postBuildHookScript>verify</postBuildHookScript>
                    <goals>
                        <goal>package</goal>
                    </goals>
                    <showErrors>true</showErrors>
                </configuration>
                <executions>
                    <execution>
                        <id>integration-test</id>
                        <goals>
                            <goal>install</goal>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <!-- What the goal resolves at build time rather than links, so it is
                                 not among this project's dependencies to be copied over with them.
                                 The projects under src/it name the runtime themselves. -->
                            <extraArtifacts>
                                <extraArtifact>org.souther-lang:souther-build-driver:${souther.default.version}</extraArtifact>
                                <extraArtifact>org.souther-lang:souther-runtime:${souther.default.version}</extraArtifact>
                            </extraArtifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- The toolchain below is rebuilt rather than added to. copy-dependencies writes into
                 whatever is there, so a version bumped without an intervening clean leaves the old
                 souther-build-driver beside the new one — and ServiceLoader takes the first
                 declaration it finds, so the tests would verify the old compiler and say they
                 verified the new one. Declared before it, so it runs first in the same phase. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>the-toolchain-of-the-last-build-is-not-this-one</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/souther-toolchain</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- A toolchain to load in the tests, standing in for what Maven Resolver hands the
                 plugin at build time: the driver and everything it needs behind it. The build API is
                 copied in with the rest on purpose — the toolchain a build resolves has one, and a
                 loader that answered from it would give the interface two identities and find no
                 driver. JUnit is left out; nothing on a real toolchain has it. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.9.0</version>
                <executions>
                    <execution>
                        <id>toolchain-for-the-tests</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>test</includeScope>
                            <excludeGroupIds>org.junit,org.opentest4j,org.apiguardian</excludeGroupIds>
                            <outputDirectory>${project.build.directory}/souther-toolchain</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- Activate for a Central release: `mvn -Prelease deploy`. Attaches sources and javadoc,
             GPG-signs every artifact, and publishes to the Sonatype Central Portal
             (autoPublish=false, so the bundle is reviewed in the Portal before release). Normal
             build/test is untouched. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
